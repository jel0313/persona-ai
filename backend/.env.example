# --- LLM（Ollama）---
OLLAMA_URL=http://localhost:11434
# 会話に使うモデル（ollama pull で取得したもの）
CHAT_MODEL=gemma3:4b
# RAG用の埋め込みモデル（日本語に強い多言語モデル）
EMBED_MODEL=bge-m3

# --- 音声合成（VOICEVOX）---
VOICEVOX_URL=http://localhost:50021

# --- 保存先 ---
DB_PATH=data/app.db
CHROMA_DIR=data/chroma

# --- その他 ---
FRONTEND_ORIGIN=http://localhost:3000
# LLMに渡す過去の会話の件数
HISTORY_LIMIT=20
# RAGで取り出す資料の数
RAG_TOP_K=3
